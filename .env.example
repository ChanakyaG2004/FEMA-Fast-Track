# Leave empty when using the same Vercel project for the frontend and API.
# For a separately hosted backend, set this to its public URL, without a
# trailing slash (for example: https://fema-fast-track-api.onrender.com).
VITE_API_BASE_URL=

# Optional: enables OpenAI-assisted extraction and review in the API runtime.
ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
